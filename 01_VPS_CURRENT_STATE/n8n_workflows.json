              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\n  \"inputs\": {},\n  \"query\": \"Califica este lead y devuelve SOLO un JSON: {score:0-100, vertical_match:bool, intent:high/medium/low, suggested_action:string, suggested_response_es:string}. Lead: nombre={{ $('Sanitizer').item.json.lead.name }}, empresa={{ $('Sanitizer').item.json.lead.company }}, email={{ $('Sanitizer').item.json.lead.email || 'N/A' }}, fuente={{ $('Sanitizer').item.json.lead.source }}\",\n  \"response_mode\": \"blocking\",\n  \"user\": \"lead-qualifier-{{ $('Sanitizer').item.json.tenant_slug }}\",\n  \"conversation_id\": \"\"\n}",
          "options": {
            "timeout": 90000
          }
        },
        "id": "4",
        "name": "Dify · Qualifier Agent",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1100,
          300
        ]
      },
      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "// Handle Dify workflow outputs or chat response\nconst raw = $input.item.json;\nlet outputs = {};\n\nif (raw.data && raw.data.outputs) {\n  // Dify workflow app response\n  outputs = raw.data.outputs;\n} else if (raw.answer) {\n  // Dify chat app response - extract JSON from answer\n  try {\n    const m = raw.answer.match(/\\{[\\s\\S]*\\}/);\n    if (m) outputs = JSON.parse(m[0]);\n  } catch(e) {}\n}\n\nconst sanitized = $('Sanitizer').item.json;\nconst taskRow = $('PG · Create task').item.json;\n\nconst score = parseInt(outputs.score) || 0;\nlet tier = 'COLD';\nif (score >= 80) tier = 'HOT';\nelse if (score >= 50) tier = 'WARM';\n\nreturn {\n  json: {\n    task_id: taskRow.id,\n    tenant_slug: sanitized.tenant_slug,\n    lead: sanitized.lead,\n    score,\n    tier,\n    vertical_match: !!outputs.vertical_match,\n    intent: outputs.intent || 'unknown',\n    suggested_action: outputs.suggested_action || '',\n    suggested_response_es: outputs.suggested_response_es || '',\n    qualified_at: new Date().toISOString()\n  }\n};"
        },
