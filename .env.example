# ═══════════════════════════════════════════════════════════════
# NEXUS SUPREME · Variables de Entorno
# Generadas por scripts/01-generate-secrets.sh
# Las API keys (Anthropic, DeepSeek, etc.) deben agregarse a mano
# ═══════════════════════════════════════════════════════════════

# ─── DOMINIO ───
DOMAIN=ainexus.mx
ACME_EMAIL=james@ainexus.com.mx
TZ=America/Mexico_City

# ─── BASES DE DATOS COMPARTIDAS ───
PG_USER=nexus
PG_PASS=<GENERAR_32_CHARS>
PG_HOST=postgres
PG_PORT=5432

REDIS_PASS=<GENERAR_32_CHARS>
REDIS_HOST=redis

QDRANT_KEY=<GENERAR_32_CHARS>
MINIO_ROOT_USER=nexusadmin
MINIO_ROOT_PASS=<GENERAR_32_CHARS>

# ─── AUTHENTIK ───
AUTHENTIK_SECRET_KEY=<GENERAR_64_CHARS>
AUTHENTIK_DB_PASS=<GENERAR_32_CHARS>

# ─── INFISICAL ───
INFISICAL_ENCRYPTION_KEY=<GENERAR_32_CHARS>
INFISICAL_AUTH_SECRET=<GENERAR_32_CHARS>

# ─── n8n ───
N8N_ENCRYPTION_KEY=<GENERAR_32_CHARS>
N8N_USER_MGMT_JWT_SECRET=<GENERAR_32_CHARS>

# ─── DIFY ───
DIFY_SECRET_KEY=<GENERAR_42_CHARS>
DIFY_SANDBOX_KEY=<GENERAR_32_CHARS>

# ─── LITELLM ───
LITELLM_MASTER_KEY=sk-nexus-<GENERAR_32_CHARS>

# ─── POSTIZ ───
POSTIZ_JWT_SECRET=<GENERAR_32_CHARS>

# ─── EVOLUTION API ───
EVOLUTION_API_KEY=<GENERAR_32_CHARS>

# ─── LISTMONK ───
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASS=<GENERAR_24_CHARS>

# ─── GHOST ───
GHOST_DB_PASS=<GENERAR_32_CHARS>

# ─── GRAFANA ───
GRAFANA_ADMIN_PASS=<GENERAR_24_CHARS>

# ─── CRAWL4AI / SKYVERN ───
CRAWL4AI_TOKEN=<GENERAR_32_CHARS>
SKYVERN_API_KEY=<GENERAR_32_CHARS>

# ═══════════════════════════════════════════════════════════════
# API KEYS — AGREGAR A MANO (NO se generan automáticamente)
# ═══════════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
GEMINI_API_KEY=...

# SMTP para transaccional (Resend recomendado)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_...
SMTP_FROM=noreply@ainexus.mx

# ═══════════════════════════════════════════════════════════════
# v1.1 ADENDUM · Users Postgres por app (security)
# ═══════════════════════════════════════════════════════════════
PG_ADMIN_USER=nexus_admin
PG_ADMIN_PASS=<GENERAR_32_CHARS>
PG_DIFY_PASS=<GENERAR_32_CHARS>
PG_N8N_PASS=<GENERAR_32_CHARS>
PG_LITELLM_PASS=<GENERAR_32_CHARS>
PG_NOCOBASE_PASS=<GENERAR_32_CHARS>
PG_LISTMONK_PASS=<GENERAR_32_CHARS>
PG_POSTIZ_PASS=<GENERAR_32_CHARS>
PG_EVOLUTION_PASS=<GENERAR_32_CHARS>
PG_PLAUSIBLE_PASS=<GENERAR_32_CHARS>
PG_GHOST_PASS=<GENERAR_32_CHARS>
PG_NEXUS_CORE_PASS=<GENERAR_32_CHARS>

# Plausible
PLAUSIBLE_SECRET_KEY=<GENERAR_64_CHARS>
PLAUSIBLE_TOTP_KEY=<GENERAR_32_CHARS>

# NocoBase
NOCOBASE_APP_KEY=<GENERAR_32_CHARS>

# Beszel agent
BESZEL_AGENT_KEY=<GENERAR_32_CHARS>

# Restic backup (semana 2)
# RESTIC_REPOSITORY=s3:s3.us-ashburn-1.oraclecloud.com/nexus-backups
# RESTIC_PASSWORD=<password fuerte cifrado>
# AWS_ACCESS_KEY_ID=<oracle s3 key>
# AWS_SECRET_ACCESS_KEY=<oracle s3 secret>
