# ═══════════════════════════════════════════════════════════════
# NEXUS SUPREME v1.3 · .env.example LIMPIO
# Solo variables activas en el deploy actual
# Generadas por scripts/01-generate-secrets.sh
# API keys: agregar a mano después de generar secretos
# ═══════════════════════════════════════════════════════════════

# ─── DOMINIO Y CONFIG ───────────────────────────────────────────
# VERIFICAR: dig +short "*.DOMAIN" debe responder con IP del VPS
DOMAIN=ainexus.mx
ACME_EMAIL=james@ainexus.com.mx
TZ=America/Mexico_City

# ─── OPERADOR ───────────────────────────────────────────────────
# WhatsApp del operador: 52 + 10 dígitos (México)
OPERATOR_WHATSAPP=5218XXXXXXXXXX

# ─── BASES DE DATOS ─────────────────────────────────────────────
PG_ADMIN_USER=nexus_admin
PG_ADMIN_PASS=<GENERADO_POR_SCRIPT>
PG_DIFY_PASS=<GENERADO_POR_SCRIPT>
PG_N8N_PASS=<GENERADO_POR_SCRIPT>
PG_LITELLM_PASS=<GENERADO_POR_SCRIPT>
PG_NEXUS_CORE_PASS=<GENERADO_POR_SCRIPT>
PG_LISTMONK_PASS=<GENERADO_POR_SCRIPT>
PG_POSTIZ_PASS=<GENERADO_POR_SCRIPT>
PG_EVOLUTION_PASS=<GENERADO_POR_SCRIPT>
PG_PLAUSIBLE_PASS=<GENERADO_POR_SCRIPT>

# ─── REDIS ──────────────────────────────────────────────────────
REDIS_PASS=<GENERADO_POR_SCRIPT>

# ─── QDRANT ─────────────────────────────────────────────────────
QDRANT_KEY=<GENERADO_POR_SCRIPT>

# ─── SERVICIOS ──────────────────────────────────────────────────
DIFY_SECRET_KEY=<GENERADO_POR_SCRIPT>
LITELLM_MASTER_KEY=sk-nexus-<GENERADO_POR_SCRIPT>
N8N_ENCRYPTION_KEY=<GENERADO_POR_SCRIPT>
N8N_USER_MGMT_JWT_SECRET=<GENERADO_POR_SCRIPT>
EVOLUTION_API_KEY=<GENERADO_POR_SCRIPT>
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASS=<GENERADO_POR_SCRIPT>
POSTIZ_JWT_SECRET=<GENERADO_POR_SCRIPT>
PLAUSIBLE_SECRET_KEY=<GENERADO_POR_SCRIPT>
PLAUSIBLE_TOTP_KEY=<GENERADO_POR_SCRIPT>
BESZEL_AGENT_KEY=<GENERADO_POR_SCRIPT>

# ─── VARIABLES DE NEGOCIO PARA WORKFLOWS n8n ────────────────────
# Completar después de configurar los servicios en su UI
AINEXUS_INSTANCE=ainexus-main
DIFY_API_KEY=CAMBIAME_DESPUES_DE_CONFIGURAR_DIFY_UI
DIFY_LEAD_QUALIFIER_KEY=CAMBIAME_DESPUES_DE_CONFIGURAR_DIFY_UI
DIFY_CONCIERGE_KEY=CAMBIAME_DESPUES_DE_CONFIGURAR_DIFY_UI
POSTIZ_API_KEY=CAMBIAME_DESPUES_DE_CONFIGURAR_POSTIZ_UI

# ─── API KEYS DE PRODUCCIÓN (LiteLLM runtime) ───────────────────
# DEEPSEEK: OBLIGATORIO para MVP (cheap-spanish, cheap-coder)
DEEPSEEK_API_KEY=sk-CAMBIAME

# Opcionales — activar cuando se requieran modelos premium
ANTHROPIC_API_KEY=OPCIONAL
OPENAI_API_KEY=OPCIONAL
GEMINI_API_KEY=OPCIONAL

# ─── SMTP (Resend recomendado) ───────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_CAMBIAME
SMTP_FROM=noreply@ainexus.mx
