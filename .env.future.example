# ═══════════════════════════════════════════════════════════════
# NEXUS SUPREME v1.3 · .env.future
# Variables para servicios de semana 2-4
# Copiar a .env cuando el servicio esté activo
# ═══════════════════════════════════════════════════════════════

# ─── BACKUPS RESTIC (activar en Día 3 antes del primer backup) ──
# RESTIC_REPOSITORY=s3:s3.us-ashburn-1.oraclecloud.com/nexus-backups
# RESTIC_PASSWORD=PASSWORD_FUERTE_DE_32_CHARS
# AWS_ACCESS_KEY_ID=ORACLE_S3_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=ORACLE_S3_SECRET

# ─── SERVICIOS FUTUROS ──────────────────────────────────────────
# Authentik (SSO)
# AUTHENTIK_SECRET_KEY=
# AUTHENTIK_DB_PASS=

# Ghost (blog)
# GHOST_DB_PASS=
# PG_GHOST_PASS=

# Infisical (secrets manager)
# INFISICAL_ENCRYPTION_KEY=
# INFISICAL_AUTH_SECRET=

# Crawl4AI (web scraping)
# CRAWL4AI_TOKEN=

# Skyvern (browser automation)
# SKYVERN_API_KEY=

# NocoBase (CRM avanzado — semana 4+)
# PG_NOCOBASE_PASS=
# NOCOBASE_APP_KEY=
