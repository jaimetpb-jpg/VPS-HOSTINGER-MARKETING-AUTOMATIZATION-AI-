        "jsonBody": "={\n  \"email\": \"{{ $('Parse · Build tier').item.json.lead.email }}\",\n  \"name\": \"{{ $('Parse · Build tier').item.json.lead.name }}\",\n  \"status\": \"enabled\",\n  \"lists\": [2],\n  \"attribs\": {\n    \"tier\": \"WARM\",\n    \"company\": \"{{ $('Parse · Build tier').item.json.lead.company }}\",\n    \"tenant\": \"{{ $('Parse · Build tier').item.json.tenant_slug }}\"\n  }\n}"
