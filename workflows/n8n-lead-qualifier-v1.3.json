        "jsonBody": "={\n  \"email\": \"{{ $('Parse · Build tier').item.json.lead.email }}\",\n  \"name\": \"{{ $('Parse · Build tier').item.json.lead.name }}\",\n  \"status\": \"enabled\",\n  \"lists\": [3],\n  \"attribs\": {\n    \"tier\": \"COLD\",\n    \"company\": \"{{ $('Parse · Build tier').item.json.lead.company }}\",\n    \"tenant\": \"{{ $('Parse · Build tier').item.json.tenant_slug }}\"\n  }\n}"
      },
      "id": "12",
      "name": "Listmonk · COLD drip",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
        500
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE ai_task SET status = 'published', published_at = NOW(), output_payload = $1::jsonb WHERE id = $2;",
        "additionalFields": {
          "queryParams": "={{ JSON.stringify($('Parse · Build tier').item.json) }},={{ $('Parse · Build tier').item.json.task_id }}"
        }
      },
      "id": "13",
      "name": "PG · Mark done",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2200,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "nexus-pg-core",
          "name": "Nexus Postgres Core"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\": true, \"received\": true, \"task_id\": \"{{ $('PG \\u00b7 Create task').item.json.id }}\"}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "14",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
