        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $('Parse · Build tier').item.json.lead.phone }}\",\n  \"text\": {{ JSON.stringify($('Parse · Build tier').item.json.suggested_response_es) }}\n}"
