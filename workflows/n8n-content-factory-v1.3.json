{
  "name": "NEXUS · Content Factory v1.2 (HITL con n8n Forms)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "content-factory",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1",
      "name": "Webhook · Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// SANITIZER · pattern Gemini\nconst body = $input.item.json.body || $input.item.json;\n\nfunction clean(text, max = 8000) {\n  if (!text) return '';\n  return String(text).replace(/[\\r\\n]+/g, ' ').replace(/\\s+/g, ' ').trim().substring(0, max);\n}\n\nconst tenant_slug = body.tenant_slug;\nif (!tenant_slug) throw new Error('tenant_slug es obligatorio');\n\nreturn {\n  json: {\n    tenant_slug,\n    topic: clean(body.topic) || 'tema por definir',\n    audience: clean(body.audience, 500) || 'general',\n    channels: body.channels || ['blog', 'social', 'email'],\n    language: body.language || 'es',\n    request_id: 'req_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8),\n    requested_at: new Date().toISOString()\n  }\n};"
      },
      "id": "2",
      "name": "Sanitizer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO ai_task (tenant_id, workflow_name, status, input_payload) SELECT id, 'content_factory', 'running', $1::jsonb FROM tenants WHERE slug = $2 RETURNING id;",
        "additionalFields": {
          "queryParams": "={{ JSON.stringify($json) }},={{ $json.tenant_slug }}"
        }
      },
      "id": "3",
      "name": "PG · Create ai_task",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        600,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "nexus-pg-core",
          "name": "Nexus Postgres Core"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://dify-api:5001/v1/workflows/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.DIFY_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"inputs\": {\n    \"topic\": \"{{ $('Sanitizer').item.json.topic }}\",\n    \"audience\": \"{{ $('Sanitizer').item.json.audience }}\",\n    \"channels\": {{ JSON.stringify($('Sanitizer').item.json.channels) }},\n    \"language\": \"{{ $('Sanitizer').item.json.language }}\",\n    \"tenant_slug\": \"{{ $('Sanitizer').item.json.tenant_slug }}\"\n  },\n  \"response_mode\": \"blocking\",\n  \"user\": \"{{ $('Sanitizer').item.json.tenant_slug }}\"\n}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "4",
      "name": "Dify · Content Factory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Parse outputs Dify\nconst outputs = $input.item.json.data?.outputs || {};\nconst sanitized = $('Sanitizer').item.json;\nconst taskRow = $('PG · Create ai_task').item.json;\n\nreturn {\n  json: {\n    task_id: taskRow.id,\n    tenant_slug: sanitized.tenant_slug,\n    request_id: sanitized.request_id,\n    topic: sanitized.topic,\n    article: outputs.article || '',\n    social_posts: outputs.social || [],\n    email_body: outputs.email || '',\n    hooks: outputs.hooks || [],\n    generated_at: new Date().toISOString()\n  }\n};"
      },
      "id": "5",
      "name": "Parse Dify output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE ai_task SET status = 'awaiting_approval', output_payload = $1::jsonb, n8n_form_url = $2 WHERE id = $3;",
        "additionalFields": {
          "queryParams": "={{ JSON.stringify($('Parse Dify output').item.json) }},={{ $execution.resumeFormUrl || ('https://n8n.' + $env.DOMAIN + '/form/' + 'nexus-approval-form') }},={{ $('Parse Dify output').item.json.task_id }}"
        }
      },
      "id": "7",
      "name": "PG · Mark awaiting_approval",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1400,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "nexus-pg-core",
          "name": "Nexus Postgres Core"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://evolution:8080/message/sendText/{{ $env.AINEXUS_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $env.OPERATOR_WHATSAPP }}\",\n  \"text\": \"\\ud83e\\udd16 *Aprobacion pendiente*\\n\\nCliente: {{ $('Parse Dify output').item.json.tenant_slug }}\\nTema: {{ $('Parse Dify output').item.json.topic }}\\n\\nAprobar o rechazar:\\n{{ $execution.resumeFormUrl }}\\n\\n_Link unico por tarea_\"\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "8",
      "name": "Notify Operator (WhatsApp)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1400,
        400
      ],
      "continueOnFail": true,
      "notes": "NOTA: $execution.resumeFormUrl usa el webhookId estatico \"nexus-content-hitl\". URL determinista: https://n8n.DOMAIN/form/nexus-content-hitl. Si el link llega vacio, implementar patron TWO-WORKFLOW (ver CLAUDE.md Fase 2.5)."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $('Wait · HITL Approval').item.json['Decision'] }}",
              "rightValue": "Aprobar y publicar",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
