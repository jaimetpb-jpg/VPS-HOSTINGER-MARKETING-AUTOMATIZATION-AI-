        "formTitle": "Aprobacion de Contenido · NEXUS",
        "formDescription": "=### Tenant: {{ $('Parse Dify output').item.json.tenant_slug }}\n**Task:** {{ $('Parse Dify output').item.json.task_id }}\n**Tema:** {{ $('Parse Dify output').item.json.topic }}\n\n---\n{{ $('Parse Dify output').item.json.article }}",
