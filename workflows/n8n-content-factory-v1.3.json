        "jsonBody": "={\n  \"name\": \"NEXUS-{{ $('Parse Dify output').item.json.request_id }}\",\n  \"subject\": \"{{ $('Parse Dify output').item.json.topic }}\",\n  \"body\": {{ JSON.stringify($('Parse Dify output').item.json.email_body) }},\n  \"content_type\": \"markdown\",\n  \"type\": \"regular\",\n  \"lists\": [1]\n}"
