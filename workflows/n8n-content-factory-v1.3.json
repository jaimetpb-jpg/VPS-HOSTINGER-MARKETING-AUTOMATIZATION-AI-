        "jsonBody": "={\n  \"posts\": {{ JSON.stringify($('Parse Dify output').item.json.social_posts) }},\n  \"tenant\": \"{{ $('Parse Dify output').item.json.tenant_slug }}\"\n}",
        "options": {}
      },
