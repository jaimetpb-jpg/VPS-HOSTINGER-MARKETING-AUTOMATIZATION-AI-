            "index": 0
          }
        ]
      ]
    },
    "Parse Dify response": {
      "main": [
        [
          {
            "node": "IF · Escalate to human?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF · Escalate to human?": {
      "main": [
        [
          {
            "node": "WhatsApp · Notify operator",
            "type": "main",
            "index": 0
          },
          {
            "node": "WhatsApp · Reply to user (escalated)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "WhatsApp · Reply to user (auto)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "WhatsApp · Reply to user (escalated)": {
      "main": [
        [
          {
