          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF · Process message": {
      "main": [
        [
          {
            "node": "Dify · Concierge Agent",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
